# Variáveis de ambiente para as notificações (Web Push).
# No Vercel: Project → Settings → Environment Variables. NÃO comite valores reais.

# Chave PRIVADA VAPID (a pública já está no código do app).
VAPID_PRIVATE_KEY=

# (Opcional) e-mail de contato exigido pelo protocolo Web Push.
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Segredo para proteger o agendador /api/cron (invente uma senha longa).
CRON_SECRET=

# As variáveis KV_REST_API_URL e KV_REST_API_TOKEN são criadas
# AUTOMATICAMENTE quando você conecta um banco KV (Upstash) ao projeto.
